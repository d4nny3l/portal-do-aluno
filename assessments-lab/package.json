{
  "name": "salta-assessments-homologacao",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node build.mjs",
    "migrate:local": "wrangler d1 migrations apply ASSESSMENTS_DB --local --persist-to .wrangler/state",
    "seed:local": "wrangler d1 execute ASSESSMENTS_DB --local --persist-to .wrangler/state --file fixtures/seed.sql",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8791 --persist-to .wrangler/state"
  },
  "devDependencies": {"wrangler": "4.158.0"}
}
