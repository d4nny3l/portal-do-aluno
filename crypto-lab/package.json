{
  "name": "salta-e2ee-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:browser": "esbuild public/demo.js --bundle --format=esm --target=es2022 --outfile=public/salta-crypto-core.js",
    "dev:local": "wrangler dev --local --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply salta-e2ee-local-only --local --persist-to .wrangler/state",
    "check": "node --check worker.js && npm test"
  },
  "dependencies": {
    "@salta/crypto-core": "*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.158.0"
  }
}
